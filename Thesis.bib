  author = {Dadkhah, Sajjad and Mahdikhani, Hassan and Danso, Priscilla Kyei and Zohourian, Alireza and Truong, Kevin Anh and Ghorbani, Ali A.},
  date = {2022-08},
  pages = {1--11},
