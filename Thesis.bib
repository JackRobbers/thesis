  title = {Multi-Channel {{Attacks}}},
  booktitle = {Cryptographic {{Hardware}} and {{Embedded Systems}} - {{CHES}} 2003},
  author = {Agrawal, Dakshi and Rao, Josyula R. and Rohatgi, Pankaj},
